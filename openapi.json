{
  "openapi": "3.1.0",
  "info": {
    "title": "LiquidFlux API",
    "version": "0.7.5",
    "description": "AI-assisted objective planning with approval-gated, deterministic Hyperliquid funding, liquidity, and risk intelligence. AI interprets constraints but does not calculate market evidence, spend funds, or execute trades."
  },
  "servers": [
    { "url": "https://hyperdesk-scout.onrender.com", "description": "Production" },
    { "url": "http://localhost:3000", "description": "Local development" }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "getDashboard",
        "summary": "Open the LiquidFlux analysis workspace",
        "responses": {
          "200": {
            "description": "Responsive LiquidFlux dashboard",
            "content": { "text/html": { "schema": { "type": "string" } } }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check service health",
        "responses": {
          "200": {
            "description": "Service is running",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApiSpec",
        "summary": "Retrieve the OpenAPI contract",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/api/v1/plan": {
      "post": {
        "operationId": "planMarketNeutralObjective",
        "summary": "Continue a bounded natural-language planning and evidence conversation",
        "description": "Uses Gemini with Groq fallback to create or revise editable constraints and answer questions from supplied analysis evidence. This route never starts analysis, spends funds, or executes trades.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PlannerRequest" },
              "example": { "message": "Find a low-risk market-neutral opportunity using no more than $1,000" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Intent-specific plan, market-information request, explanation, clarification, or unsupported response",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlannerResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "502": { "$ref": "#/components/responses/AIProviderError" },
          "503": { "$ref": "#/components/responses/AIUnavailable" }
        }
      }
    },
    "/api/v1/market-overview": {
      "post": {
        "operationId": "getMarketOverview",
        "summary": "Research Hyperliquid markets with snapshot, funding-history, order-book, and grounded AI evidence",
        "description": "Returns unranked snapshot facts plus topic-gated 72-hour funding and visible L2-book summaries for up to five symbols. With question, AI findings cite server-issued evidence IDs. Citation validation is not independent fact verification. Never executes trades.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/MarketOverviewRequest"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Market evidence including unavailable symbols and nullable facts",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/MarketOverviewResponse"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "429": {"$ref": "#/components/responses/RateLimited"},
          "502": {"$ref": "#/components/responses/UpstreamError"},
          "504": {"$ref": "#/components/responses/UpstreamError"}
        }
      }
    },
    "/api/v1/orchestrate": {
      "post": {
        "operationId": "orchestrateMarketNeutralIncome",
        "summary": "Coordinate Hyperliquid funding, liquidity, and risk specialists",
        "description": "Runs a traceable market-neutral-income workflow. It returns evidence and an approval boundary; it never executes a trade.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OrchestrationRequest" },
              "example": { "objective": "market_neutral_income", "symbols": ["BTC", "ETH", "SOL"], "risk_tolerance": "moderate", "max_leverage": 2, "max_notional_usd": 1000, "min_funding_apr": 5 }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Specialist workflow completed",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrchestrationResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "502": { "$ref": "#/components/responses/UpstreamError" },
          "504": { "$ref": "#/components/responses/UpstreamError" }
        }
      }
    },
    "/api/v1/funding-scan": {
      "post": {
        "operationId": "scanFunding",
        "summary": "Scan Hyperliquid perpetual markets for funding opportunities",
        "description": "Returns deterministic metrics from a current market snapshot. Annualized funding is not a forecast.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FundingScanRequest" },
              "example": { "symbols": ["BTC", "ETH", "SOL"], "min_funding_apr": 5, "risk_tolerance": "moderate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Funding scan completed",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FundingScanResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "502": { "$ref": "#/components/responses/UpstreamError" },
          "504": { "$ref": "#/components/responses/UpstreamError" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "RateLimited": {
        "description": "Client exceeded the request limit",
        "headers": {
          "Retry-After": { "schema": { "type": "integer", "minimum": 1 } }
        },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "UpstreamError": {
        "description": "Hyperliquid is unavailable or timed out",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "AIProviderError": {
        "description": "Every configured AI planning provider failed",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "AIUnavailable": {
        "description": "No AI planning provider is configured",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status", "service", "version"],
        "properties": {
          "status": { "const": "ok" },
          "service": { "const": "hyperdesk-scout" },
          "version": { "type": "string" }
        }
      },
      "PlannerRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message"],
        "properties": {
          "message": { "type": "string", "minLength": 1, "maxLength": 1000, "description": "Validated after trimming; must contain 1–1000 characters." },
          "conversation": {
            "type": "array",
            "maxItems": 12,
            "description": "Chronological bounded user/assistant history used to resolve follow-up references. The current message is not duplicated here.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "content"],
              "properties": {
                "role": { "type": "string", "enum": ["user", "assistant"] },
                "content": { "type": "string", "minLength": 1, "maxLength": 1000 }
              }
            }
          },
          "current_plan": { "$ref": "#/components/schemas/CompletePlan" },
          "analysis_context": {
            "type": "object",
            "description": "Bounded reduced evidence from the currently displayed deterministic analysis. Treated as untrusted context."
          }
        }
      },
      "CompletePlan": {
        "type": "object",
        "additionalProperties": false,
        "required": ["objective", "symbols", "risk_tolerance", "max_leverage", "max_notional_usd", "min_funding_apr"],
        "properties": {
          "objective": { "const": "market_neutral_income" },
          "symbols": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "pattern": "^[A-Za-z0-9:_-]{1,30}$" } },
          "risk_tolerance": { "type": "string", "enum": ["conservative", "moderate", "aggressive"] },
          "max_leverage": { "type": "number", "minimum": 1, "maximum": 10 },
          "max_notional_usd": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 },
          "min_funding_apr": { "type": "number", "minimum": 0, "maximum": 10000 }
        }
      },
      "PlannerResponse": {
        "description": "Normalized public outputs omit inapplicable fields from the internal flat nullable provider schema. All intents retain provider metadata and approval/execution boundaries.",
        "oneOf": [{"$ref": "#/components/schemas/PlannerPlanUpdateResponse"}, {"$ref": "#/components/schemas/PlannerMarketInformationResponse"}, {"$ref": "#/components/schemas/PlannerResultExplanationResponse"}, {"$ref": "#/components/schemas/PlannerClarificationResponse"}, {"$ref": "#/components/schemas/PlannerUnsupportedResponse"}],
        "discriminator": {
          "propertyName": "intent",
          "mapping": {"plan_update": "#/components/schemas/PlannerPlanUpdateResponse", "market_information": "#/components/schemas/PlannerMarketInformationResponse", "result_explanation": "#/components/schemas/PlannerResultExplanationResponse", "clarification": "#/components/schemas/PlannerClarificationResponse", "unsupported": "#/components/schemas/PlannerUnsupportedResponse"}
        }
      },
      "PlannerPlanUpdateResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "intent", "reply", "summary", "assumptions", "missing_information", "provider", "model", "specialist_plan", "approval_required", "execution_included", "objective", "symbols", "risk_tolerance", "max_leverage", "max_notional_usd", "min_funding_apr", "suggested_defaults"],
        "properties": {
          "request_id": {"type": "string"},
          "intent": {"const": "plan_update"},
          "reply": {"type": "string", "minLength": 1, "maxLength": 1000},
          "summary": {"type": "string", "minLength": 1},
          "assumptions": {
            "type": "array",
            "maxItems": 8,
            "items": {"type": "string", "minLength": 1}
          },
          "missing_information": {
            "type": "array",
            "maxItems": 5,
            "items": {"type": "string", "minLength": 1}
          },
          "provider": {"type": "string", "enum": ["gemini", "groq"]},
          "model": {"type": "string"},
          "specialist_plan": {
            "type": "array",
            "items": {"type": "object"}
          },
          "approval_required": {"const": true},
          "execution_included": {"const": false},
          "objective": {"const": "market_neutral_income"},
          "symbols": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Z0-9:_-]{1,30}$"}
          },
          "risk_tolerance": {"type": "string", "enum": ["conservative", "moderate", "aggressive"]},
          "max_leverage": {"type": "number", "minimum": 1, "maximum": 10},
          "max_notional_usd": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000},
          "min_funding_apr": {"type": "number", "minimum": 0, "maximum": 10000},
          "suggested_defaults": {
            "type": "array",
            "maxItems": 6,
            "uniqueItems": true,
            "items": {"type": "string", "enum": ["objective", "symbols", "risk_tolerance", "max_leverage", "max_notional_usd", "min_funding_apr"]}
          }
        }
      },
      "PlannerMarketInformationResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "intent", "reply", "summary", "assumptions", "missing_information", "provider", "model", "specialist_plan", "approval_required", "execution_included", "symbols", "topics"],
        "properties": {
          "request_id": {"type": "string"},
          "intent": {"const": "market_information"},
          "reply": {"type": "string", "minLength": 1, "maxLength": 1000},
          "summary": {"type": "string", "minLength": 1},
          "assumptions": {
            "type": "array",
            "maxItems": 8,
            "items": {"type": "string", "minLength": 1}
          },
          "missing_information": {
            "type": "array",
            "maxItems": 5,
            "items": {"type": "string", "minLength": 1}
          },
          "provider": {"type": "string", "enum": ["gemini", "groq"]},
          "model": {"type": "string"},
          "specialist_plan": {
            "type": "array",
            "items": {"type": "object"}
          },
          "approval_required": {"const": true},
          "execution_included": {"const": false},
          "symbols": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Z0-9:_-]{1,30}$"}
          },
          "topics": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {"type": "string", "enum": ["funding", "basis", "liquidity", "risk"]},
            "uniqueItems": true
          }
        }
      },
      "PlannerResultExplanationResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "intent", "reply", "summary", "assumptions", "missing_information", "provider", "model", "specialist_plan", "approval_required", "execution_included"],
        "properties": {
          "request_id": {"type": "string"},
          "intent": {"const": "result_explanation"},
          "reply": {"type": "string", "minLength": 1, "maxLength": 1000},
          "summary": {"type": "string", "minLength": 1},
          "assumptions": {
            "type": "array",
            "maxItems": 8,
            "items": {"type": "string", "minLength": 1}
          },
          "missing_information": {
            "type": "array",
            "maxItems": 5,
            "items": {"type": "string", "minLength": 1}
          },
          "provider": {"type": "string", "enum": ["gemini", "groq"]},
          "model": {"type": "string"},
          "specialist_plan": {
            "type": "array",
            "items": {"type": "object"}
          },
          "approval_required": {"const": true},
          "execution_included": {"const": false}
        }
      },
      "PlannerClarificationResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "intent", "reply", "summary", "assumptions", "missing_information", "provider", "model", "specialist_plan", "approval_required", "execution_included"],
        "properties": {
          "request_id": {"type": "string"},
          "intent": {"const": "clarification"},
          "reply": {"type": "string", "minLength": 1, "maxLength": 1000},
          "summary": {"type": "string", "minLength": 1},
          "assumptions": {
            "type": "array",
            "maxItems": 8,
            "items": {"type": "string", "minLength": 1}
          },
          "missing_information": {
            "type": "array",
            "maxItems": 5,
            "items": {"type": "string", "minLength": 1}
          },
          "provider": {"type": "string", "enum": ["gemini", "groq"]},
          "model": {"type": "string"},
          "specialist_plan": {
            "type": "array",
            "items": {"type": "object"}
          },
          "approval_required": {"const": true},
          "execution_included": {"const": false}
        }
      },
      "PlannerUnsupportedResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "intent", "reply", "summary", "assumptions", "missing_information", "provider", "model", "specialist_plan", "approval_required", "execution_included"],
        "properties": {
          "request_id": {"type": "string"},
          "intent": {"const": "unsupported"},
          "reply": {"type": "string", "minLength": 1, "maxLength": 1000},
          "summary": {"type": "string", "minLength": 1},
          "assumptions": {
            "type": "array",
            "maxItems": 8,
            "items": {"type": "string", "minLength": 1}
          },
          "missing_information": {
            "type": "array",
            "maxItems": 5,
            "items": {"type": "string", "minLength": 1}
          },
          "provider": {"type": "string", "enum": ["gemini", "groq"]},
          "model": {"type": "string"},
          "specialist_plan": {
            "type": "array",
            "items": {"type": "object"}
          },
          "approval_required": {"const": true},
          "execution_included": {"const": false}
        }
      },
      "MarketOverviewRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbols"],
        "properties": {
          "symbols": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {"type": "string", "pattern": "^[A-Za-z0-9:_-]{1,30}$"}
          },
          "topics": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {"type": "string", "enum": ["funding", "basis", "liquidity", "risk"]},
            "default": ["funding", "basis", "liquidity", "risk"]
          },
          "question": {"type": "string", "minLength": 1, "maxLength": 1000, "description": "Original user question for evidence-grounded analysis"}
        }
      },
      "MarketOverviewMarket": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "status", "facts", "calculations", "notices"],
        "properties": {
          "symbol": {"type": "string"},
          "status": {"enum": ["available", "unavailable"]},
          "facts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "funding": {
                "type": "object",
                "additionalProperties": false,
                "required": ["hourly_rate"],
                "properties": {
                  "hourly_rate": {"type": ["number", "null"]}
                }
              },
              "basis": {
                "type": "object",
                "additionalProperties": false,
                "required": ["mark_price", "oracle_price"],
                "properties": {
                  "mark_price": {"type": ["number", "null"]},
                  "oracle_price": {"type": ["number", "null"]}
                }
              },
              "liquidity": {
                "type": "object",
                "additionalProperties": false,
                "required": ["mark_price", "open_interest_base", "volume_24h_usd", "impact_bid_price", "impact_ask_price"],
                "properties": {
                  "mark_price": {"type": ["number", "null"]},
                  "open_interest_base": {"type": ["number", "null"]},
                  "volume_24h_usd": {"type": ["number", "null"]},
                  "impact_bid_price": {"type": ["number", "null"]},
                  "impact_ask_price": {"type": ["number", "null"]}
                }
              },
              "risk": {
                "type": "object",
                "additionalProperties": false,
                "required": ["max_leverage", "is_delisted"],
                "properties": {
                  "max_leverage": {"type": ["number", "null"]},
                  "is_delisted": {"type": ["boolean", "null"]}
                }
              }
            }
          },
          "calculations": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "funding": {
                "type": "object",
                "additionalProperties": false,
                "required": ["annualized_simple_percent"],
                "properties": {
                  "annualized_simple_percent": {"type": ["number", "null"]}
                }
              },
              "basis": {
                "type": "object",
                "additionalProperties": false,
                "required": ["mark_oracle_deviation_percent"],
                "properties": {
                  "mark_oracle_deviation_percent": {"type": ["number", "null"]}
                }
              },
              "liquidity": {
                "type": "object",
                "additionalProperties": false,
                "required": ["open_interest_notional_usd", "impact_spread_bps"],
                "properties": {
                  "open_interest_notional_usd": {"type": ["number", "null"]},
                  "impact_spread_bps": {"type": ["number", "null"]}
                }
              }
            }
          },
          "notices": {
            "type": "array",
            "items": {"type": "string"}
          },
          "research": {"type": ["object", "null"], "additionalProperties": true, "description": "Topic-gated 72-hour funding and visible order-book summaries"}
        },
        "description": "One entry per normalized requested symbol, including unavailable markets. Only requested topics appear; risk has no calculations. Missing or invalid inputs and non-finite calculations produce null and notices. No ranking or financial filtering."
      },
      "MarketOverviewEvidence": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "endpoint", "request_type", "fetched_at", "age_ms", "cache_status", "data_status"],
        "properties": {
          "source": {"const": "Hyperliquid"},
          "endpoint": {"const": "/info"},
          "request_type": {"const": "metaAndAssetCtxs"},
          "fetched_at": {"type": ["string", "null"], "format": "date-time"},
          "age_ms": {"type": ["number", "null"], "minimum": 0},
          "cache_status": {"type": ["string", "null"]},
          "data_status": {"enum": ["fresh", "stale", "unknown"]}
        },
        "description": "Shared provider snapshot metadata; fetched_at is a fetch timestamp, not an exchange timestamp. Missing metadata is null."
      },
      "MarketOverviewResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "generated_at", "query", "evidence", "markets", "notices", "evidence_ledger", "analysis", "execution_included"],
        "properties": {
          "request_id": {"type": "string"},
          "generated_at": {"type": "string", "format": "date-time"},
          "query": {
            "type": "object",
            "additionalProperties": false,
            "required": ["symbols", "topics"],
            "properties": {
              "symbols": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "items": {"type": "string", "pattern": "^[A-Za-z0-9:_-]{1,30}$"},
                "uniqueItems": true
              },
              "topics": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {"type": "string", "enum": ["funding", "basis", "liquidity", "risk"]},
                "uniqueItems": true
              }
            }
          },
          "evidence": {"$ref": "#/components/schemas/MarketOverviewEvidence"},
          "markets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {"$ref": "#/components/schemas/MarketOverviewMarket"}
          },
          "notices": {
            "type": "array",
            "items": {"type": "string"}
          },
          "research": {"type": "object", "additionalProperties": true},
          "evidence_ledger": {"type": "array", "items": {"type": "object"}, "description": "Server-built records referenced by grounded AI finding IDs"},
          "analysis": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["completed", "unavailable"]}, "answer": {"type": "string"}, "findings": {"type": "array", "items": {"type": "object"}}, "caveats": {"type": "array", "items": {"type": "string"}}, "next_questions": {"type": "array", "items": {"type": "string"}}, "provider": {"type": "string"}, "model": {"type": "string"}, "grounding": {"type": "string"}, "reason": {"type": "string"}}, "description": "Optional interpretation; citation IDs are validated but prose is not independently fact-verified"},
          "execution_included": {"const": false}
        }
      },

      "FundingScanRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "symbols": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9:_-]{1,30}$" },
            "default": ["BTC", "ETH", "SOL"]
          },
          "min_funding_apr": { "type": "number", "minimum": 0, "default": 0 },
          "risk_tolerance": { "type": "string", "enum": ["conservative", "moderate", "aggressive"], "default": "moderate" }
        }
      },
      "FundingScanResponse": {
        "type": "object",
        "required": ["request_id", "service", "version", "generated_at", "data_source", "data_status", "market_data", "methodology", "query", "unavailable_symbols", "opportunities", "disclaimer"],
        "properties": {
          "request_id": { "type": "string" },
          "service": { "const": "LiquidFlux Funding Specialist" },
          "version": { "type": "string" },
          "generated_at": { "type": "string", "format": "date-time" },
          "data_source": { "const": "Hyperliquid mainnet" },
          "data_status": { "type": "string", "enum": ["fresh", "stale"] },
          "market_data": { "$ref": "#/components/schemas/MarketDataMetadata" },
          "methodology": { "type": "object", "additionalProperties": { "type": "string" } },
          "query": { "type": "object" },
          "unavailable_symbols": { "type": "array", "items": { "type": "string" } },
          "opportunities": { "type": "array", "items": { "$ref": "#/components/schemas/Opportunity" } },
          "disclaimer": { "type": "string" }
        }
      },
      "MarketDataMetadata": {
        "type": "object",
        "required": ["fetched_at", "age_ms", "cache_status", "fetch_duration_ms"],
        "properties": {
          "fetched_at": { "type": "string", "format": "date-time" },
          "age_ms": { "type": "integer", "minimum": 0 },
          "cache_status": { "type": "string", "enum": ["hit", "miss", "stale_fallback"] },
          "fetch_duration_ms": { "type": "integer", "minimum": 0 }
        }
      },
      "Opportunity": {
        "type": "object",
        "required": ["symbol", "maxLeverage", "fundingRate", "fundingAprPercent", "markPrice", "oraclePrice", "basisPercent", "openInterest", "openInterestNotionalUsd", "volume24hUsd", "impactSpreadBps", "liquidityScore", "riskScore", "opportunityScore", "riskFlags"],
        "properties": {
          "symbol": { "type": "string" },
          "maxLeverage": { "type": "number" },
          "fundingRate": { "type": "number" },
          "fundingAprPercent": { "type": "number" },
          "markPrice": { "type": "number" },
          "oraclePrice": { "type": "number" },
          "basisPercent": { "type": "number" },
          "openInterest": { "type": "number" },
          "openInterestNotionalUsd": { "type": "number" },
          "volume24hUsd": { "type": "number" },
          "impactSpreadBps": { "type": ["number", "null"] },
          "liquidityScore": { "type": "number", "minimum": 0, "maximum": 1 },
          "riskScore": { "type": "number", "minimum": 0, "maximum": 1 },
          "opportunityScore": { "type": "number", "minimum": 0, "maximum": 1 },
          "riskFlags": { "type": "array", "items": { "type": "string" } }
        }
      },
      "OrchestrationRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "objective": { "const": "market_neutral_income", "default": "market_neutral_income" },
          "symbols": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "pattern": "^[A-Za-z0-9:_-]{1,30}$" }, "default": ["BTC", "ETH", "SOL"] },
          "risk_tolerance": { "type": "string", "enum": ["conservative", "moderate", "aggressive"], "default": "moderate" },
          "max_leverage": { "type": "number", "minimum": 1, "maximum": 10, "default": 2 },
          "max_notional_usd": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000, "default": 1000 },
          "min_funding_apr": { "type": "number", "minimum": 0, "maximum": 10000, "default": 5 }
        }
      },
      "OrchestrationResponse": {
        "type": "object",
        "required": ["request_id", "service", "version", "workflow_id", "generated_at", "objective", "execution_included", "approval_required", "workflow", "provenance", "constraints", "unavailable_symbols", "specialist_outputs", "conflicts", "synthesis", "disclaimer"],
        "properties": {
          "request_id": { "type": "string" },
          "service": { "const": "LiquidFlux Orchestrator" },
          "version": { "type": "string" },
          "workflow_id": { "type": "string" },
          "generated_at": { "type": "string", "format": "date-time" },
          "objective": { "const": "market_neutral_income" },
          "execution_included": { "const": false },
          "approval_required": { "const": true },
          "workflow": { "type": "object" },
          "provenance": { "type": "object" },
          "constraints": { "type": "object" },
          "unavailable_symbols": { "type": "array", "items": { "type": "string" } },
          "specialist_outputs": { "type": "object" },
          "conflicts": { "type": "array", "items": { "type": "object" } },
          "synthesis": { "type": "object" },
          "disclaimer": { "type": "string" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["request_id", "error", "message"],
        "properties": {
          "request_id": { "type": "string" },
          "error": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
