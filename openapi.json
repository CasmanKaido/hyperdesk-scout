          "execution_included": { "const": false },
          "approval_required": { "const": true },
          "workflow": { "type": "object" },
          "provenance": { "type": "object" },
          "constraints": { "type": "object" },
          "unavailable_symbols": { "type": "array", "items": { "type": "string" } },
          "specialist_outputs": { "type": "object" },
          "conflicts": { "type": "array", "items": { "type": "object" } },
          "synthesis": { "type": "object" },
          "disclaimer": { "type": "string" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["request_id", "error", "message"],
        "properties": {
          "request_id": { "type": "string" },
          "error": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
