{
  "openapi": "3.1.0",
  "info": {
    "title": "LiquidFlux API",
    "version": "0.4.0",
    "description": "AI-assisted objective planning with approval-gated, deterministic Hyperliquid funding, liquidity, and risk intelligence. AI interprets constraints but does not calculate market evidence, spend funds, or execute trades."
  },
  "servers": [
    { "url": "https://hyperdesk-scout.onrender.com", "description": "Production" },
    { "url": "http://localhost:3000", "description": "Local development" }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "getDashboard",
        "summary": "Open the LiquidFlux analysis workspace",
        "responses": {
          "200": {
            "description": "Responsive LiquidFlux dashboard",
            "content": { "text/html": { "schema": { "type": "string" } } }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check service health",
        "responses": {
          "200": {
            "description": "Service is running",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApiSpec",
        "summary": "Retrieve the OpenAPI contract",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/api/v1/plan": {
      "post": {
        "operationId": "planMarketNeutralObjective",
        "summary": "Continue a bounded natural-language planning and evidence conversation",
        "description": "Uses Gemini with Groq fallback to create or revise editable constraints and answer questions from supplied analysis evidence. This route never starts analysis, spends funds, or executes trades.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PlannerRequest" },
              "example": { "message": "Find a low-risk market-neutral opportunity using no more than $1,000" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Objective interpreted into an editable specialist plan",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlannerResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "502": { "$ref": "#/components/responses/AIProviderError" },
          "503": { "$ref": "#/components/responses/AIUnavailable" }
        }
      }
    },
    "/api/v1/orchestrate": {
      "post": {
        "operationId": "orchestrateMarketNeutralIncome",
        "summary": "Coordinate Hyperliquid funding, liquidity, and risk specialists",
        "description": "Runs a traceable market-neutral-income workflow. It returns evidence and an approval boundary; it never executes a trade.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OrchestrationRequest" },
              "example": { "objective": "market_neutral_income", "symbols": ["BTC", "ETH", "SOL"], "risk_tolerance": "moderate", "max_leverage": 2, "max_notional_usd": 1000, "min_funding_apr": 5 }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Specialist workflow completed",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrchestrationResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "502": { "$ref": "#/components/responses/UpstreamError" },
          "504": { "$ref": "#/components/responses/UpstreamError" }
        }
      }
    },
    "/api/v1/funding-scan": {
      "post": {
        "operationId": "scanFunding",
        "summary": "Scan Hyperliquid perpetual markets for funding opportunities",
        "description": "Returns deterministic metrics from a current market snapshot. Annualized funding is not a forecast.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FundingScanRequest" },
              "example": { "symbols": ["BTC", "ETH", "SOL"], "min_funding_apr": 5, "risk_tolerance": "moderate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Funding scan completed",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FundingScanResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "502": { "$ref": "#/components/responses/UpstreamError" },
          "504": { "$ref": "#/components/responses/UpstreamError" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "RateLimited": {
        "description": "Client exceeded the request limit",
        "headers": {
          "Retry-After": { "schema": { "type": "integer", "minimum": 1 } }
        },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "UpstreamError": {
        "description": "Hyperliquid is unavailable or timed out",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "AIProviderError": {
        "description": "Every configured AI planning provider failed",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "AIUnavailable": {
        "description": "No AI planning provider is configured",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status", "service", "version"],
        "properties": {
          "status": { "const": "ok" },
          "service": { "const": "hyperdesk-scout" },
          "version": { "type": "string" }
        }
      },
      "PlannerRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message"],
        "properties": {
          "message": { "type": "string", "minLength": 10, "maxLength": 1000 },
          "current_plan": { "$ref": "#/components/schemas/CompletePlan" },
          "analysis_context": {
            "type": "object",
            "description": "Bounded reduced evidence from the currently displayed deterministic analysis. Treated as untrusted context."
          }
        }
      },
      "CompletePlan": {
        "type": "object",
        "additionalProperties": false,
        "required": ["objective", "symbols", "risk_tolerance", "max_leverage", "max_notional_usd", "min_funding_apr"],
        "properties": {
          "objective": { "const": "market_neutral_income" },
          "symbols": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "pattern": "^[A-Za-z0-9:_-]{1,30}$" } },
          "risk_tolerance": { "type": "string", "enum": ["conservative", "moderate", "aggressive"] },
          "max_leverage": { "type": "number", "minimum": 1, "maximum": 10 },
          "max_notional_usd": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 },
          "min_funding_apr": { "type": "number", "minimum": 0, "maximum": 10000 }
        }
      },
      "PlannerResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "intent", "reply", "summary", "objective", "symbols", "risk_tolerance", "max_leverage", "max_notional_usd", "min_funding_apr", "assumptions", "missing_information", "provider", "model", "specialist_plan", "approval_required", "execution_included"],
        "properties": {
          "request_id": { "type": "string" },
          "intent": { "type": "string", "enum": ["plan_update", "result_explanation", "clarification", "unsupported"] },
          "reply": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "objective": { "const": "market_neutral_income" },
          "symbols": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9:_-]{1,30}$" } },
          "risk_tolerance": { "type": "string", "enum": ["conservative", "moderate", "aggressive"] },
          "max_leverage": { "type": "number", "minimum": 1, "maximum": 10 },
          "max_notional_usd": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 },
          "min_funding_apr": { "type": "number", "minimum": 0, "maximum": 10000 },
          "assumptions": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
          "missing_information": { "type": "array", "maxItems": 5, "items": { "type": "string" } },
          "provider": { "type": "string", "enum": ["gemini", "groq"] },
          "model": { "type": "string" },
          "specialist_plan": { "type": "array", "items": { "type": "object" } },
          "approval_required": { "const": true },
          "execution_included": { "const": false }
        }
      },
      "FundingScanRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "symbols": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9:_-]{1,30}$" },
            "default": ["BTC", "ETH", "SOL"]
          },
          "min_funding_apr": { "type": "number", "minimum": 0, "default": 0 },
          "risk_tolerance": { "type": "string", "enum": ["conservative", "moderate", "aggressive"], "default": "moderate" }
        }
      },
      "FundingScanResponse": {
        "type": "object",
        "required": ["request_id", "service", "version", "generated_at", "data_source", "data_status", "market_data", "methodology", "query", "unavailable_symbols", "opportunities", "disclaimer"],
        "properties": {
          "request_id": { "type": "string" },
          "service": { "const": "LiquidFlux Funding Specialist" },
          "version": { "type": "string" },
          "generated_at": { "type": "string", "format": "date-time" },
          "data_source": { "const": "Hyperliquid mainnet" },
          "data_status": { "type": "string", "enum": ["fresh", "stale"] },
          "market_data": { "$ref": "#/components/schemas/MarketDataMetadata" },
          "methodology": { "type": "object", "additionalProperties": { "type": "string" } },
          "query": { "type": "object" },
          "unavailable_symbols": { "type": "array", "items": { "type": "string" } },
          "opportunities": { "type": "array", "items": { "$ref": "#/components/schemas/Opportunity" } },
          "disclaimer": { "type": "string" }
        }
      },
      "MarketDataMetadata": {
        "type": "object",
        "required": ["fetched_at", "age_ms", "cache_status", "fetch_duration_ms"],
        "properties": {
          "fetched_at": { "type": "string", "format": "date-time" },
          "age_ms": { "type": "integer", "minimum": 0 },
          "cache_status": { "type": "string", "enum": ["hit", "miss", "stale_fallback"] },
          "fetch_duration_ms": { "type": "integer", "minimum": 0 }
        }
      },
      "Opportunity": {
        "type": "object",
        "required": ["symbol", "maxLeverage", "fundingRate", "fundingAprPercent", "markPrice", "oraclePrice", "basisPercent", "openInterest", "openInterestNotionalUsd", "volume24hUsd", "impactSpreadBps", "liquidityScore", "riskScore", "opportunityScore", "riskFlags"],
        "properties": {
          "symbol": { "type": "string" },
          "maxLeverage": { "type": "number" },
          "fundingRate": { "type": "number" },
          "fundingAprPercent": { "type": "number" },
          "markPrice": { "type": "number" },
          "oraclePrice": { "type": "number" },
          "basisPercent": { "type": "number" },
          "openInterest": { "type": "number" },
          "openInterestNotionalUsd": { "type": "number" },
          "volume24hUsd": { "type": "number" },
          "impactSpreadBps": { "type": ["number", "null"] },
          "liquidityScore": { "type": "number", "minimum": 0, "maximum": 1 },
          "riskScore": { "type": "number", "minimum": 0, "maximum": 1 },
          "opportunityScore": { "type": "number", "minimum": 0, "maximum": 1 },
          "riskFlags": { "type": "array", "items": { "type": "string" } }
        }
      },
      "OrchestrationRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "objective": { "const": "market_neutral_income", "default": "market_neutral_income" },
          "symbols": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "pattern": "^[A-Za-z0-9:_-]{1,30}$" }, "default": ["BTC", "ETH", "SOL"] },
          "risk_tolerance": { "type": "string", "enum": ["conservative", "moderate", "aggressive"], "default": "moderate" },
          "max_leverage": { "type": "number", "minimum": 1, "maximum": 10, "default": 2 },
          "max_notional_usd": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000, "default": 1000 },
          "min_funding_apr": { "type": "number", "minimum": 0, "maximum": 10000, "default": 5 }
        }
      },
      "OrchestrationResponse": {
        "type": "object",
        "required": ["request_id", "service", "version", "workflow_id", "generated_at", "objective", "execution_included", "approval_required", "workflow", "provenance", "constraints", "unavailable_symbols", "specialist_outputs", "conflicts", "synthesis", "disclaimer"],
        "properties": {
          "request_id": { "type": "string" },
          "service": { "const": "LiquidFlux Orchestrator" },
          "version": { "type": "string" },
          "workflow_id": { "type": "string" },
          "generated_at": { "type": "string", "format": "date-time" },
          "objective": { "const": "market_neutral_income" },
          "execution_included": { "const": false },
          "approval_required": { "const": true },
          "workflow": { "type": "object" },
          "provenance": { "type": "object" },
          "constraints": { "type": "object" },
          "unavailable_symbols": { "type": "array", "items": { "type": "string" } },
          "specialist_outputs": { "type": "object" },
          "conflicts": { "type": "array", "items": { "type": "object" } },
          "synthesis": { "type": "object" },
          "disclaimer": { "type": "string" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["request_id", "error", "message"],
        "properties": {
          "request_id": { "type": "string" },
          "error": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
